# Container/runtime settings
MODEL_REPO=meta-models/Muse-Glimmer-30B-GGUF
MODEL_DIR=/runpod-volume/models/muse-glimmer-30b
PORT=8000

# The three official Meta files. Keep these names in sync with the HF repo.
MAIN_MODEL_FILE=Muse-Glimmer-30B-KQuant-Dynamic-Q4_K_XL.gguf
MMPROJ_FILE=mmproj-Muse-Glimmer-30B-Q4_K_M.gguf
DRAFT_MODEL_FILE=dflash-Muse-Glimmer-30B-Q4_K_M.gguf

# Runtime sizing defaults for a single 24-32 GB NVIDIA GPU.
CONTEXT_SIZE=131072
PARALLEL_SLOTS=1
N_GPU_LAYERS=all
DRAFT_N_GPU_LAYERS=all
DRAFT_N_MAX=3
REASONING_BUDGET=-1
REASONING_STRENGTH=high
DOWNLOAD_MODELS=1

# Optional Hugging Face token. The repo is public as of this worker design;
# use a token only if the repo becomes gated or rate limits require it.
# HF_TOKEN=
